# Frontend (Vite) vars - set locally in .env and in Vercel as Environment Variables
# (these come from the NEW Supabase project for The Good Hours, once Ashley creates it)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side ONLY - set in Vercel Environment Variables, NEVER with a VITE_ prefix
# (used by /api/generate-plan.js; a VITE_ prefix would expose it in the browser)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: use Open-Meteo's customer endpoints for production/commercial use.
# Without this, weather uses the public endpoint and still needs no client key.
# OPEN_METEO_API_KEY=...
